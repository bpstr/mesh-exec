      "role": "ROLE_USER",
      "parts": [
        {
          "text": "I recommend bullets when updates contain several owners, blockers, or next steps: scanability makes accountability clearer. A short paragraph is better for one tightly connected narrative, since it preserves causality and avoids artificial fragmentation. Practical default: 2–4 bullets; use a paragraph only for a single cohesive update. Do you see a case where the default should be reversed?",
          "mediaType": "text/plain"
        }
      ],
